#!/usr/bin/python3
"""Operate the existing board gadget with validated shared catalog images."""
import json
import errno
import os
from pathlib import Path
import sys

sys.path.insert(0, '/usr/lib/vim4-kvm/python')
import vim4media

GADGET = Path('/sys/kernel/config/usb_gadget/kvm')
PROFILE = GADGET / 'configs/c.1'
LUN = GADGET / 'functions/mass_storage.disk0/lun.0'
IMAGES = Path('/var/lib/kvmd/msd')
STATE = Path('/run/vim4-pikvm-usb/state.json')
DISK = 'mass_storage.disk0'
NETWORK = 'ncm.usb0'


def write(name, value):
    (LUN / name).write_text(value + '\n')


def prepare():
    if (LUN / 'file').read_text().strip():
        raise ValueError('Eject the existing virtual disk before switching to PiKVM')
    if STATE.exists():
        restore()  # Recover a previous failed stop after the host has ejected.
    links = {p.name for p in PROFILE.iterdir() if p.is_symlink()}
    allowed = {'hid.keyboard', 'hid.mouse_abs', 'hid.mouse_rel', DISK, NETWORK}
    if not links <= allowed:
        raise ValueError('Unsupported active USB function; restore the board profile first')
    STATE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    snapshot = {
        'disk': DISK in links, 'network': NETWORK in links,
        'udc': (GADGET / 'UDC').read_text().strip(),
        'ro': (LUN / 'ro').read_text().strip(),
        'cdrom': (LUN / 'cdrom').read_text().strip(),
    }
    STATE.write_text(json.dumps(snapshot))
    try:
        if snapshot['network'] or not snapshot['disk']:
            (GADGET / 'UDC').write_text('\n')
            (PROFILE / NETWORK).unlink(missing_ok=True)
            if not snapshot['disk']:
                (PROFILE / DISK).symlink_to(GADGET / 'functions' / DISK)
            (GADGET / 'UDC').write_text(snapshot['udc'] + '\n')
    except Exception:
        restore()
        raise


def restore():
    if not STATE.exists():
        return
    snapshot = json.loads(STATE.read_text())
    write('file', '')
    if snapshot['network'] or not snapshot['disk']:
        (GADGET / 'UDC').write_text('\n')
        if not snapshot['disk']:
            (PROFILE / DISK).unlink(missing_ok=True)
        if snapshot['network'] and not (PROFILE / NETWORK).is_symlink():
            (PROFILE / NETWORK).symlink_to(GADGET / 'functions' / NETWORK)
        (GADGET / 'UDC').write_text(snapshot['udc'] + '\n')
    write('ro', snapshot['ro'])
    write('cdrom', snapshot['cdrom'])
    STATE.unlink()


def insert(path):
    identifier = path
    if Path(path).is_absolute():
        for source, root in {**vim4media.IMAGE_ROOTS, 'data': vim4media.DATA_DIR}.items():
            if Path(path).is_relative_to(root):
                identifier = source + '/' + str(Path(path).relative_to(root))
                break
        else:
            raise ValueError('Image must be in the media catalog')
    with vim4media.media_locks(wait=True):
        if (LUN / 'file').read_text().strip():
            raise ValueError('Eject the existing virtual disk first')
        fd = vim4media.open_image(identifier, readonly=True)
        try:
            write('ro', '1')
            if not identifier.startswith('pikvm/'):
                write('cdrom', '1' if identifier.lower().endswith('.iso') else '0')
            write('file', f'/proc/self/fd/{fd}')
        finally:
            os.close(fd)


def main(args):
    if args == ['catalog']:
        print(json.dumps(vim4media.catalog()))
    elif args == ['prepare']:
        with vim4media.media_locks(wait=True):
            prepare()
    elif args == ['restore']:
        with vim4media.media_locks(wait=True):
            restore()
    elif len(args) == 2 and args[0] in ('file', 'forced_eject', 'ro', 'cdrom', 'notify'):
        if not STATE.exists():
            raise ValueError('PiKVM does not own the virtual disk')
        name, value = args
        if name == 'notify' and not value:
            with (LUN / 'file').open('r+'):
                pass
        elif name in ('ro', 'cdrom') and value in ('0', '1'):
            write(name, value)
        elif name in ('file', 'forced_eject') and not value:
            with vim4media.media_locks(wait=True):
                write('file', '')
        elif name == 'file':
            insert(value)
        else:
            raise ValueError('Invalid media operation')
    else:
        raise ValueError('Invalid media operation')


if __name__ == '__main__':
    try:
        main(sys.argv[1:])
    except OSError as error:
        if error.errno == errno.EBUSY:
            sys.exit('The USB host has locked the media; eject it on the host first')
        sys.exit(str(error))
    except ValueError as error:
        sys.exit(str(error))
